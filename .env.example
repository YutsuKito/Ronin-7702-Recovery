# Optional custom Ronin RPC. Leave unchanged for the public Ronin RPC.
RONIN_RPC_URL=https://api.roninchain.com/rpc

# Use a separate clean relayer wallet only.
# Never place the affected wallet's key, recovery password, OTP, token or shard here.
RELAYER_PRIVATE_KEY=

# Broadcast also requires the CLI --broadcast flag.
ALLOW_BROADCAST=false
