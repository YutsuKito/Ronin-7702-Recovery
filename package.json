{
  "name": "ronin-7702-recovery",
  "version": "0.3.0",
  "private": true,
  "description": "Defensive Ronin EIP-7702 recovery toolkit with local Waypoint MPC signing and sponsored deauthorization.",
  "type": "module",
  "scripts": {
    "rescue": "tsx src/cli.ts",
    "signer": "next dev signer-next -H 127.0.0.1 -p 4173",
    "signer:build": "next build signer-next",
    "typecheck": "tsc --noEmit && tsc -p signer-next/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@sky-mavis/waypoint": "4.2.2",
    "commander": "14.0.0",
    "dotenv": "17.2.1",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.37.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
